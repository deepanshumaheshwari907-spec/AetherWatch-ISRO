# AetherWatch Configuration
# Generated configuration file for deployment

# === API Configuration ===
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# === Streamlit Configuration ===
STREAMLIT_PORT=8501
STREAMLIT_LOGGER_LEVEL=info

# === Database Configuration ===
DATABASE_PATH=aetherwatch_telemetry.db
DATABASE_AUTO_INIT=true

# === Satellite Data Configuration ===
DATA_DIR=data
DEMO_DATA_FILE=demo_insat.h5
SATELLITE_DATA_URL=https://raw.githubusercontent.com/datasets/master/sample.h5

# === AI Model Configuration ===
MODEL_PATH=core/unet_trained_weights.pth
USE_GPU=true
MODEL_CHECKPOINT_DIR=models/checkpoints

# === Risk Engine Configuration ===
THERMAL_THRESHOLD_KELVIN=235
MIN_REGION_RADIUS_KM=1
MIN_REGION_AREA_KM2=34800

# === Logging Configuration ===
LOG_LEVEL=INFO
LOG_FILE=logs/aetherwatch.log
LOG_FORMAT=json
LOG_TO_CONSOLE=true

# === Security Configuration ===
ENABLE_AUTH=false
SECRET_KEY=dev-key-change-in-production

# === Feature Flags ===
ENABLE_LIVE_DATA_FETCH=true
ENABLE_DATABASE_LOGGING=true
ENABLE_ALERTS=true
